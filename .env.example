# LLM 配置（OpenAI 兼容 API）
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 固定开发端口（勿随意修改，与 vite.config.ts 中 API 代理一致）
SERVER_PORT=8787
# 前端固定为 http://localhost:5173（vite strictPort）

# 外部集成（可选，也可在立项列表「外部集成」中配置）
# JIRA_BASE_URL=https://your-company.atlassian.net
# JIRA_PROJECT_KEY=INIT
# FEISHU_PROJECT_BASE_URL=https://project.feishu.cn
# FEISHU_PROJECT_ID=your-project-id
# JIRA_WEBHOOK_URL=https://hooks.example.com/initiation
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/...
